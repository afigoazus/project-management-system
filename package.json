{
  "name": "project-management",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "bun x prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:migrate": "bun x prisma migrate dev --config=packages/database/prisma.config.ts",
    "db:push": "bun x prisma db push --config=packages/database/prisma.config.ts",
    "db:seed": "bun packages/database/prisma/seed.ts",
    "db:studio": "bun x prisma studio --config=packages/database/prisma.config.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.10.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/client": "^7.9.0",
    "prisma": "^7.9.0"
  }
}
