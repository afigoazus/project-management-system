{
  "name": "@workspace/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "migrate": "prisma migrate dev --config=prisma.config.ts",
    "push": "prisma db push --config=prisma.config.ts",
    "seed": "bun prisma/seed.ts",
    "studio": "prisma studio --config=prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.0",
    "typescript": "^5"
  }
}
